# Copy to .env and fill in real values. NEVER commit .env.
# Generate a secret key:   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list, needed behind HTTPS in production, e.g. https://lostfound.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database: PostgreSQL only (EduRev P09 Track P). Keep exactly ONE DB_BACKEND line:
# the first occurrence of a key in this file wins. First-time setup: scripts\setup_postgres.ps1
DB_BACKEND=postgres
POSTGRES_DB=lostfound
POSTGRES_USER=lostfound
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Fernet key(s) protecting PrivateDetail and verification answers.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation, list the NEW key first, comma-separated with old keys.
FIELD_ENCRYPTION_KEYS=

# Optional account policy: restrict self-registration to these email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=
# Optional: Lost & Found team and administrator accounts must use these domains (e.g. campus.edu)
ALLOWED_STAFF_EMAIL_DOMAINS=
# Staff sign-in code lifetime (seconds) and attempts; activation/reset link lifetime (seconds)
STAFF_CODE_TTL_SECONDS=600
STAFF_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_TIMEOUT=259200

# Campus map (Leaflet + OpenStreetMap). Leave blank to hide the map picker.
CAMPUS_MAP_CENTER_LAT=
CAMPUS_MAP_CENTER_LNG=
CAMPUS_MAP_ZOOM=17

# Email delivery. Default prints emails in the server console.
# For Gmail: turn on 2-Step Verification, create an App password, then set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=Campus Lost & Found <your.address@gmail.com>
# Keep exactly ONE EMAIL_BACKEND line (the first occurrence wins). Console prints emails to the
# terminal; switch to the SMTP block above for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
